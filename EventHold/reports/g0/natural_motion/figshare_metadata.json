 null, "is_mandatory": false}, {"name": "Location", "value": "", "settings": {"validations": {"min_length": 1, "max_length": 2500}, "placeholder": "Location"}, "field_type": "textarea", "order": null, "is_mandatory": false}], "figshare_url": "https://data.lib.vt.edu/articles/dataset/Virginia_Tech_Natural_Motion_Dataset/14114054", "download_disabled": false, "description": "The Virginia Tech Natural Motion Dataset contains 40 hours of unscripted human motion (full body kinematics) collected in the open world using an XSens MVN Link system.  In total, there are data from 17 participants (13 participants on a college campus and 4 at a home improvement store).  Participants did a wide variety of activities, including: walking from one place to another; operating machinery; talking with others; manipulating objects; working at a desk; driving; eating; pushing/pulling carts and dollies; physical exercises such as jumping jacks, jogging, and pushups; sweeping; vacuuming; and emptying a dishwasher.  The code for analyzing the data is freely available with this dataset and also at: https://github.com/ARLab-VT/VT-Natural-Motion-Processing. The portion of the dataset involving workers was funded by Lowe's, Inc.", "funding": null, "funding_list": [], "version": 3, "status": "public", "size": 401706705760, "created_date": "2021-06-03T14:15:10Z", "modified_date": "2021-06-03T14:15:10Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 119, "name": "CC BY-NC 3.0 US", "url": "https://creativecommons.org/licenses/by-nc/3.0/us/"}, "tags": ["natural motion", "kinematics", "activities of daily living", "machine learning", "python", "deep learning", "self-supervised learning", "inertial motion capture", "inertial sensors", "tutorial", "motion inference", "Machine Learning", "Mechanical Engineering", "pytorch", "Mechanical Engineering"], "keywords": ["natural motion", "kinematics", "activities of daily living", "machine learning", "python", "deep learning", "self-supervised learning", "inertial motion capture", "inertial sensors", "tutorial", "motion inference", "Machine Learning", "Mechanical Engineering", "pytorch", "Mechanical Engineering"], "categories": [{"id": 33530, "title": "Mechanical engineering not elsewhere classified", "parent_id": 33503, "path": "/32963/33503/33530", "source_id": "401799", "taxonomy_id": 102}], "references": [], "has_linked_file": false, "citation": "Jack Geissinger; Alan Asbeck; Mohammad Mehdi Alemi; S. Emily Chang (2020). Virginia Tech Natural Motion Dataset. University Libraries, Virginia Tech. Dataset. https://doi.org/10.7294/2v3w-sb92", "related_materials": [], "is_embargoed": false, "embargo_date": null, "embargo_type": "file", "embargo_title": "", "embargo_reason": "", "embargo_options": [], "id": 14114054, "title": "Virginia Tech Natural Motion Dataset", "doi": "10.7294/2v3w-sb92", "handle": "", "url": "https://api.figshare.com/v2/articles/14114054", "published_date": "2021-06-03T14:15:09Z", "thumb": "https://s3-eu-west-1.amazonaws.com/ppreviews-virginiatech-3631867540/27505097/thumb.png", "defined_type": 3, "defined_type_name": "dataset", "group_id": 31649, "url_private_api": "https://api.figshare.com/v2/account/articles/14114054", "url_public_api": "https://api.figshare.com/v2/articles/14114054", "url_private_html": "https://figshare.com/account/articles/14114054", "url_public_html": "https://data.lib.vt.edu/articles/dataset/Virginia_Tech_Natural_Motion_Dataset/14114054", "timeline": {"posted": "2021-06-03T14:15:09", "publisherPublication": "2020-08-13T00:00:00", "firstOnline": "2020-08-13"}, "resource_title": null, "resource_doi": null}